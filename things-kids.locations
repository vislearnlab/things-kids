# Install: sudo cp /labs/vislearnlab/things-kids/things-kids.locations /etc/nginx/locations/
# Then:    sudo nginx -t && sudo systemctl restart nginx
#
# Note: upstream is http:// (not https://) because the Node server runs
# plain HTTP on localhost. nginx terminates TLS at the public edge.
#
# Port 9010 — 9009 is mochi-kids, and 9000/9001/9002/9005/9011 are taken.
# BASE_PATH=things-kids in .env must match the prefix below, or the built
# assets resolve to / and the page loads blank.
location /things-kids/ {
    client_max_body_size 50M;
    client_body_temp_path /data/temp;
    proxy_pass http://localhost:9010/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
}
